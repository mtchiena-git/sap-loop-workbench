# ---- 模式（預設全部 mock，離線可跑）
LLM_MODE=mock            # mock | gateway
SAP_MODE=mock            # mock | abap
EXTRACT_MODE=mock        # mock | abap | adt

# ---- LLM gateway（LLM_MODE=gateway）
LLM_BASE_URL=https://llm-gw.internal/v1
LLM_API_KEY=
LLM_MODEL=

# ---- SAP BFF（SAP_MODE=abap）
SAP_BFF_URL=https://bff.internal/sap
SAP_BFF_TOKEN=

# ---- 抽取（EXTRACT_MODE=abap|adt）
SAP_EXTRACT_URL=https://d01.internal:44300/sap/bc/zapi/loop_extract
SAP_ADT_URL=https://d01.internal:44300/sap/bc/adt
SAP_USER=
SAP_PASS=

# ---- 其他
LOOP_DB=loop.db
PORT=8080
